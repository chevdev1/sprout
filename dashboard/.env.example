# WalletConnect Cloud project ID (required for the WalletConnect
# connector to actually work — get one free at https://cloud.reown.com).
# Without it, MetaMask/injected/Safe wallets still work fine; only the
# WalletConnect QR-code connector is degraded.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Real on-chain payment for the $5 card-issuance fee (src/lib/payments.ts,
# src/app/apply/page.tsx). Both required or the Apply screen shows
# "Payment not configured yet" and disables the pay button — it never
# falls back to a fake/mock charge.
#
# NEXT_PUBLIC_TREASURY_ADDRESS: the wallet that receives the fee.
# NEXT_PUBLIC_USDG_ADDRESS: USDG's contract address on Robinhood Chain
#   Testnet (chain ID 46630) — verify against
#   docs.robinhood.com/chain/contracts or the testnet explorer's token
#   list before setting this. Do not guess or reuse the Ethereum
#   mainnet USDG address — it's a different contract on a different
#   chain.
NEXT_PUBLIC_TREASURY_ADDRESS=
NEXT_PUBLIC_USDG_ADDRESS=
